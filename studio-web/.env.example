# Adept UI Studio Web — Environment Variables
#
# Copy to .env.local for local dev, or set in Vercel Project Settings for hosted beta.
# VITE_* variables are PUBLIC (client-visible) — never put secrets here.

# Public Studio API base URL.
# - Local dev: leave unset (defaults to "" → relative /api/* via Vite proxy)
# - Hosted beta: https://api-beta.adeptui.org
VITE_API_BASE=
