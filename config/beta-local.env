# Adept UI V1.1 Owner Beta — local production runtime (committed, no secrets).
# Machine-specific overrides: config/beta-local.local.env (gitignored).

ADEPT_UI_BETA_RUNTIME=1

# Fixed ports (do not randomize — bookmarks and shortcuts depend on these)
STUDIO_API_HOST=127.0.0.1
STUDIO_API_PORT=8758
STUDIO_WEB_HOST=127.0.0.1
STUDIO_WEB_PORT=8760
STUDIO_COMFY_URL=http://127.0.0.1:8188

# Data — absolute path ensures correct resolution regardless of working directory
STUDIO_DATA_DIR=C:\AdeptFilmWorks\AIVideoStudio\data

# Forbidden in Beta runtime (fixtures / Playwright harness)
STUDIO_E2E=0
ADEPT_M29_FIXTURE_MODE=0
ADEPT_M28_FIXTURE_MODE=0
ADEPT_PACK_PROVIDER=

# Certified production feature flags (M3.2g + V1.1 product surface)
STUDIO_FEATURE_PRODUCTION_EXECUTIVE_V1=1
STUDIO_FEATURE_CODIRECTOR_INTELLIGENCE_V2=1
STUDIO_FEATURE_VISION_VALIDATION_V1=1
STUDIO_FEATURE_TIMELINE_REFERENCES_V1=1
STUDIO_FEATURE_DIRECTOR_TIMELINE_V1=1
STUDIO_FEATURE_LIPSYNC_PRODUCTION_V1=1
STUDIO_FEATURE_AUDIO_PRODUCTION_V1=1
STUDIO_FEATURE_EDITING_PRODUCTION_V1=1
STUDIO_FEATURE_RENDER_PRODUCTION_V1=1
STUDIO_FEATURE_IMAGE_PRODUCTION_V1=1
STUDIO_FEATURE_FRAME_PRODUCTION_V1=1
STUDIO_FEATURE_VIDEO_PRODUCTION_V1=1
STUDIO_FEATURE_M210B_AUDIO_SANDBOX_V1=1
STUDIO_FEATURE_CHARACTER_IDENTITY_V1=1
STUDIO_FEATURE_CODIRECTOR_PRODUCTION_CONTROL_V1=1
STUDIO_FEATURE_CODIRECTOR_PRODUCTION_INTELLIGENCE_V1=1
STUDIO_FEATURE_CODIRECTOR_ADAPTIVE_LEARNING_V1=1
STUDIO_FEATURE_CODIRECTOR_OPERATIONAL_AGENT_V1=1

# Lipsync / WAN helpers used in Hitchhiker cert
STUDIO_LIPSYNC_DIRECT=1
STUDIO_LIPSYNC_PREFER_STILL_FACE=1
STUDIO_WAN_TEXT_ENCODER=umt5_xxl_fp8_e4m3fn_scaled.safetensors
TORCHDYNAMO_DISABLE=1

# Runtime supervisor
ADEPT_BETA_MIN_FREE_GB=10
ADEPT_BETA_API_RESTART_MAX=3
ADEPT_BETA_WEB_RESTART_MAX=3
ADEPT_BETA_RESTART_WINDOW_SEC=600
ADEPT_BETA_HEALTH_TIMEOUT_SEC=120
# Optional: set in beta-local.local.env to auto-start Comfy when unhealthy
# ADEPT_COMFY_LAUNCH=

# MiniMax H3 — Private owner-only Route A integration (isolated ComfyUI :8192).
# Public Creator / Best Match / general routing remain OFF. Do NOT set
# STUDIO_COMFY_MODELS_DIR=D:\01_Models globally.
STUDIO_FEATURE_MINIMAX_H3_PRIVATE_LOCAL=1
STUDIO_MINIMAX_H3_OWNER_ONLY=true
STUDIO_MINIMAX_H3_PUBLIC_CREATOR_ENABLED=false
STUDIO_MINIMAX_H3_BEST_MATCH_ENABLED=false
STUDIO_MINIMAX_H3_GENERAL_ROUTING_ENABLED=false
STUDIO_MINIMAX_H3_RUNTIME_URL=http://127.0.0.1:8192
STUDIO_MINIMAX_H3_MODEL_ROOT=D:\01_Models
