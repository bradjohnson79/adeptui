# Copy to config/beta-local.local.env (gitignored) and edit for this machine.
# Loaded after config/beta-local.env — values here win.

# Absolute data dir if not using repo ./data
# STUDIO_DATA_DIR=C:\AdeptFilmWorks\AIVideoStudio\data

# ComfyUI Shared folders (optional overrides)
# STUDIO_COMFY_INPUT_DIR=C:\Users\YOU\AppData\Local\Comfy-Desktop\ComfyUI-Shared\input
# STUDIO_COMFY_OUTPUT_DIR=C:\Users\YOU\AppData\Local\Comfy-Desktop\ComfyUI-Shared\output

# Command to start Comfy when http://127.0.0.1:8188/system_stats is unhealthy.
# Leave unset to run Beta in DEGRADED mode without auto-starting Comfy.
# ADEPT_COMFY_LAUNCH=C:\Users\YOU\AppData\Local\Programs\ComfyUI\ComfyUI.exe

# ADEPT_BETA_MIN_FREE_GB=20
