<component type="desktop-application">
  <id>app.adeptui.desktop</id>
  <name>Adept UI</name>
  <summary>AI Filmmaking &amp; Production Studio</summary>
  <developer id="inc.anoint">
    <name>ANOINT Inc.</name>
  </developer>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>LicenseRef-proprietary</project_license>
  <url type="homepage">https://www.adeptui.org/</url>
  <description>
    <p>Adept UI is an AI filmmaking and production studio from ANOINT Inc. It brings characters, storyboards, images, video, voice, and the timeline together so a creator can direct a film in one application.</p>
    <p>Create characters, build storyboards, generate images and videos, direct scenes, and finish a film in one application. Local models and hosted API services stay separate choices.</p>
    <p>ComfyUI is a manual prerequisite for local generation. Commercial API models do not require it.</p>
  </description>
  <launchable type="desktop-id">Adept UI.desktop</launchable>
